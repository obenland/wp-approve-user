{
  "require": {
    "php": ">=7.0"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "WordPressPlugin\\": "./php"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WordPressPlugin\\Tests\\": "./tests"
    }
  },
  "scripts": {
    "test": "phpunit --config=tests/phpunit.xml"
  }
}
